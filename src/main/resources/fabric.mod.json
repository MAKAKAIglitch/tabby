{
  "schemaVersion": 1,
  "id": "tabby",
  "version": "${version}",
  "name": "Tabby",
  "description": "Browser-style client tabs for Minecraft 1.21.11.",
  "contact": {
    "homepage": "https://github.com/MAKAKAIglitch",
    "sources": "https://github.com/MAKAKAIglitch/tabby",
    "issues": "https://github.com/MAKAKAIglitch/tabby/issues"
  },
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.tabby.TabbyClient"
    ],
    "modmenu": [
      "dev.tabby.compat.TabbyModMenu"
    ]
  },
  "accessWidener": "tabby.accesswidener",
  "mixins": [
    "tabby.mixins.json",
    "tabby.optional.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  },
  "suggests": {
    "modmenu": ">=17.0.1"
  },
  "authors": [
    "MAKAKAIglitch"
  ]
}
