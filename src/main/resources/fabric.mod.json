{
  "schemaVersion": 1,
  "id": "tabby",
  "version": "${version}",
  "name": "Tabby",
  "description": "Browser-style client tabs for Minecraft 26.2.",
  "contact": {
    "homepage": "https://github.com/MAKAKAIglitch",
    "sources": "https://github.com/MAKAKAIglitch/tabby",
    "issues": "https://github.com/MAKAKAIglitch/tabby/issues"
  },
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": ["dev.tabby.TabbyClient"],
    "modmenu": ["dev.tabby.compat.TabbyModMenu"]
  },
  "accessWidener": "tabby.accesswidener",
  "mixins": [
    "tabby.mixins.json",
    "tabby.optional.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.20.1",
    "minecraft": "26.2",
    "java": ">=25",
    "fabric-api": "*"
  },
  "suggests": {
    "modmenu": ">=20.0.3"
  },
  "authors": ["MAKAKAIglitch"]
}
